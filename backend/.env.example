# SereneAI backend configuration. There is intentionally NO AI API key setting:
# all AI/ML runs locally inside this backend.
DATABASE_URL=postgresql+psycopg2://sereneai:sereneai@localhost:5432/sereneai
JWT_SECRET=change-me-to-a-long-random-string
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Optional
ACCESS_TOKEN_MINUTES=720
RATE_LIMIT_ENABLED=true
SEED_DEMO=true
